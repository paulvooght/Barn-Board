# board-assets: keep each wall's source photo + crop + detection JSON; ignore the
# throwaway previews (_grid/_debug) and the derived responsive variants (served
# from Supabase, regenerated by publish_board_image.py).
board-assets/**/_*
board-assets/**/*-800w.jpg
board-assets/**/*-1200w.jpg
board-assets/**/*-2000w.jpg

# Hold-detection (detect_holds_v2.py): model weights auto-download into cwd, and
# the FastSAM venv is local-only. Never commit these (weights are ~100+ MB).
*.pt
FastSAM-*.pt
sam*.pt
mobile_sam*.pt
.venv-detect/
